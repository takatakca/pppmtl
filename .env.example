# PPPMTL — environment variables (EXAMPLE: variable names only, no real values)
#
# Copy this file to `.env` — or set the variables in the hosting panel
# (Coolify / Node app environment) — and fill in the real values THERE.
# Never commit real values, never put server secrets in client `VITE_*`
# variables, and rotate any secret that has ever been exposed.
#
# Identity contract: PPPMTL does NOT keep its own master customer table.
# Customer identity is the canonical TAKATAK identity — the Supabase
# project « TAKATAK User Official Dashboard V1 » (takatakca/takatak-v1),
# per docs/IDENTITY_INTEGRATION.md. PPP holds restaurant-tenant data
# (orders) only, scoped by tenant.

# ---------------------------------------------------------------------------
# Public site
# ---------------------------------------------------------------------------

# Canonical public URL of this deployment (redirects, webhooks, links).
PUBLIC_SITE_URL=https://pppmtl.com

# ---------------------------------------------------------------------------
# Clover (server-side only)
# ---------------------------------------------------------------------------

# Clover merchant ID of the restaurant merchant account.
CLOVER_MERCHANT_ID=
# Ecommerce private key (Hosted Checkout API token's private key).
CLOVER_ECOMM_PRIVATE_KEY=
# Signing secret generated by the Clover Hosted Checkout webhook page.
CLOVER_WEBHOOK_SECRET=
# Optional REST API token (Inventory read, Orders read/write, Payments
# read, Merchant read). Without it, Hosted Checkout payments still work,
# but automatic order titling/printing and tablet mirroring are covered
# by the Food Hub OAuth app instead.
CLOVER_API_TOKEN=
# Clover environment: sandbox | production
CLOVER_ENV=
# Tax rates applied per line, as configured for the merchant
# (Quebec: GST 5 % + QST 9.975 %, two rates on the pre-tax base).
CLOVER_TAX_RATES=
# Whether web orders print automatically on the merchant printer: on | off
CLOVER_PRINT_WEB_ORDERS=

# ---------------------------------------------------------------------------
# PPP order access + temporary admin bootstrap (server-side only)
# ---------------------------------------------------------------------------

# HMAC secret signing the guest order-access cookie (32+ random
# characters, stable across releases).
PPP_ORDER_ACCESS_SECRET=
# TEMPORARY operations login credential (32+ random characters).
# Bootstrap only: it is retired as soon as authorized TAKATAK
# administrator roles are live. It is not a TAKATAK role or entitlement.
PPP_ADMIN_ACCESS_TOKEN=
# Session-signing secret for the temporary admin bootstrap (32+ random
# characters, distinct from PPP_ADMIN_ACCESS_TOKEN).
PPP_ADMIN_SESSION_SECRET=

# ---------------------------------------------------------------------------
# Back-end wiring — Supabase (TAKATAK identity) + PostgreSQL (durable orders)
#
# Required BEFORE enabling the customer repository (backendEnabled) and
# BEFORE any live Clover payment. See the « Back-end prerequisites »
# section of docs/DEPLOYMENT.md. Issues #5 and #6 gate production
# payments.
# ---------------------------------------------------------------------------

# URL of the canonical TAKATAK Supabase project
# (« TAKATAK User Official Dashboard V1 »). PPP never creates its own
# Supabase project or master customer table.
SUPABASE_URL=
# Supabase anon (public) key of the TAKATAK project — the only Supabase
# key the client side may ever see. The Supabase service_role key is
# NEVER used in PPP and must NEVER be exposed to the browser.
SUPABASE_ANON_KEY=
# PostgreSQL 15+ connection string for the PPP tenant database: durable
# order storage plus signed-event replay/outbox. Apply db/migrations 0001,
# 0002, 0003 (in order) as the admin user, then connect the site with the
# LIMITED role (no SUPERUSER / BYPASSRLS; grants in docs/DB_ROLLOUT.md).
# Required for production Clover checkout.
DATABASE_URL=
# Optional restaurant tenant id for this deployment (default "pppmtl").
PPP_TENANT_ID=

# ---------------------------------------------------------------------------
# "Sign in with TAKATAK" (Google / e-mail / phone on takatak.ca) — server only
# Register pppmtl.com in TAKATAK's Supabase: Authentication -> OAuth Server ->
# add a confidential client with redirect URI
#   https://pppmtl.com/auth/takatak/callback
# Leave empty to keep the checkout guest-only (the button stays hidden).
# ---------------------------------------------------------------------------
TAKATAK_OAUTH_CLIENT_ID=
TAKATAK_OAUTH_CLIENT_SECRET=
# Optional; default is the TAKATAK production project's auth URL.
TAKATAK_AUTH_ISSUER=

# ---------------------------------------------------------------------------
# Interac e-Transfer, manual (docs/integrations/interac.md) — server only
# The restaurant sends "Request money" from its bank app, then taps Paid on
# /admin/interac. Needs DATABASE_URL (outside a Clover sandbox).
# ---------------------------------------------------------------------------
INTERAC_REQUESTS_ENABLED=
# Phone texted for each new Interac order (needs the Twilio keys below).
INTERAC_ALERT_PHONE=
# Twilio (also used for "my driver" texts, docs/integrations/couriers.md).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ---------------------------------------------------------------------------
# BMO Instant Payments: Interac "Request money" sent and confirmed by itself
# (docs/integrations/interac.md › BMO automatic requests). Server only.
# Register with BMO: redirect https://pppmtl.com/auth/bmo/callback and push
# notifications https://pppmtl.com/api/public/webhooks/bmo. Empty = manual.
# ---------------------------------------------------------------------------
BMO_ENV=sandbox
BMO_CLIENT_ID=
BMO_CLIENT_SECRET=
# Only if BMO gives a separate API key (default: BMO_CLIENT_ID).
BMO_API_KEY=
BMO_CREDITOR_ACCOUNT=
BMO_CREDITOR_NAME=PPP Pizzeria
# BMO's public key (PEM) and its id; our private key (PEM). "\n" line breaks OK.
BMO_ENCRYPTION_PUBLIC_KEY=
BMO_ENCRYPTION_KEY_ID=
BMO_PRIVATE_KEY=
BMO_PUSH_SECRET=
# Production only (BMO gives them): BMO_API_BASE_URL, BMO_OAUTH_BASE_URL.
# Rarely needed: BMO_OAEP_HASH (sha1|sha256), BMO_PAYLOAD_ENCRYPTION=off,
# BMO_TRUE_CLIENT_IP, BMO_CREDITOR_AGENT_ID (001), BMO_REQUEST_EXPIRY_MINUTES (60).
